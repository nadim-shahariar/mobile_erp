APP_NAME="Mobile Shop ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default: SQLite file. For production use MySQL 8 / MariaDB 10.6+.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=mobile_shop_erp
# DB_USERNAME=erp
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Mobile Shop ERP
# ---------------------------------------------------------------------------
# Business-day boundary and display timezone (timestamps are stored in UTC).
ERP_TIMEZONE=Asia/Dhaka
ERP_CURRENCY_CODE=BDT
ERP_CURRENCY_SYMBOL="৳"

# Business identity printed on documents (also editable in Settings).
ERP_COMPANY_NAME="Mobile Shop ERP"
ERP_COMPANY_ADDRESS=
ERP_COMPANY_PHONE=
ERP_COMPANY_EMAIL=

# Bootstrap branch names. Rename to the real shop units after install.
ERP_UNIT_ONE_NAME="Unit 1"
ERP_UNIT_TWO_NAME="Unit 2"

# First owner account created by `php artisan db:seed`.
# CHANGE THE PASSWORD IMMEDIATELY AFTER FIRST LOGIN.
ERP_OWNER_NAME="Shop Owner"
ERP_OWNER_EMAIL=owner@example.com
ERP_OWNER_PASSWORD="ChangeMe!2026"

# IMEI policy: require 15-digit Luhn checks unless explicitly overridden.
ERP_IMEI_REQUIRE_LUHN=true
ERP_IMEI_ALLOW_LEGACY_OVERRIDE=true
